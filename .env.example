# MongoDB Atlas or local MongoDB
MONGODB_URI='your-mongodb url'

# Optional: set to production URL in deployment environments
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: AI-written roasts (set these in Vercel → Settings → Environment Variables, then redeploy).
# Any OpenAI-compatible provider works. Nothing model-specific is in the code — use the model id your
# provider currently lists, and just change ROAST_AI_MODEL when they release a new one.
# Without these, Flow uses its built-in roast lines.
# ROAST_AI_PROVIDER=groq              # groq | gemini | custom
# ROAST_AI_MODEL=your-model-id        # required, e.g. the current model name from the provider console
# ROAST_AI_API_KEY=your-key           # or GROQ_API_KEY / GEMINI_API_KEY
# ROAST_AI_BASE_URL=                  # optional override; required for custom
