# MongoDB Atlas or local MongoDB
MONGODB_URI='your-mongodb url'

# Optional: set to production URL in deployment environments
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: AI-written roasts. Pick one provider and set its key (in Vercel → Settings → Environment Variables).
# Without these, Flow uses its built-in roast lines.
# ROAST_AI_PROVIDER=groq            # or: gemini
# GROQ_API_KEY=your-groq-key
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL=gemini-2.5-flash
